{
  "manifest_version": 3,
  "name": "granny",
  "version": "0.1.1",
  "description": "Every navigation goes through granny. Work first, play after.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["intercept.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "action": { "default_title": "Granny Agent" }
}
