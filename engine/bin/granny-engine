#!/usr/bin/env bash
# Launches the bundled Pi Durable sidecar (`exec` preserves PID for LOCAL_PEERPID).
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "$DIR/granny-engine.mjs" ]; then
  ENTRY="$DIR/granny-engine.mjs"
elif [ -f "$DIR/../build/granny-engine.mjs" ]; then
  ENTRY="$DIR/../build/granny-engine.mjs"
else
  echo "granny-engine: bundle missing; run scripts/build-engine.sh" >&2
  exit 2
fi

node_ok() {
  local bin="$1"
  [ -n "$bin" ] && [ -x "$bin" ] || return 1
  "$bin" -e '
    const [maj, min] = process.versions.node.split(".").map(Number);
    process.exit(maj > 22 || (maj === 22 && min >= 19) ? 0 : 1);
  ' >/dev/null 2>&1
}

find_node() {
  if [ -n "${GRANNY_NODE:-}" ] && node_ok "$GRANNY_NODE"; then
    echo "$GRANNY_NODE"
    return 0
  fi
  for candidate in \
    "$(command -v node 2>/dev/null || true)" \
    /opt/homebrew/bin/node \
    /usr/local/bin/node \
    "$HOME/.volta/bin/node"; do
    if node_ok "$candidate"; then
      echo "$candidate"
      return 0
    fi
  done
  if [ -d "$HOME/.nvm/versions/node" ]; then
    local best=""
    for candidate in "$HOME"/.nvm/versions/node/v*/bin/node; do
      if node_ok "$candidate"; then
        best="$candidate"
      fi
    done
    if [ -n "$best" ]; then
      echo "$best"
      return 0
    fi
  fi
  return 1
}

NODE_BIN="$(find_node || true)"
if [ -z "$NODE_BIN" ]; then
  echo "granny-engine: Node.js >= 22.19 is required" >&2
  exit 2
fi

exec "$NODE_BIN" --no-warnings "$ENTRY" "$@"
