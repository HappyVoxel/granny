{
  "name": "granny-engine",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Granny's proactive Pi Durable sidecar over <state dir>/engine.sock.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=build/granny-engine.mjs",
    "test": "npm run build && node --test build/test/*.test.js"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
